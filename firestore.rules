rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'edets.aniekan@gmail.com';
    }

    // Helper for validating a new tribute
    function isValidTribute(data) {
      return data.keys().hasAll(['name', 'relation', 'message', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.relation is string && data.relation.size() > 0 && data.relation.size() <= 50 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 3)); // allow optional images
    }

    match /tributes/{tributeId} {
      // Anyone can read approved tributes
      allow read: if resource.data.status == 'approved';
      
      // Admin has full access
      allow read, write: if isAdmin();
      
      // Allow any anonymous user to submit a tribute
      allow create: if request.auth != null && isValidTribute(request.resource.data) && request.resource.data.status == 'pending';
    }
  }
}
