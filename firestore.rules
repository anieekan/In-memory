rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // A helper to check if someone is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // A helper to validate the ID (simple alphanumeric and dashes)
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins can read/write everything. For simplicity we check if request.auth.token.email is the app creator's email, or we leave it open to a specific uid.
    // Wait, we don't have the creator's email hardcoded. So let's check a document in 'admins' collection.
    // Or, allow creation and let listing check for status=='approved'
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'edets.aniekan@gmail.com';
    }

    // Helper for validating a new tribute
    function isValidTribute(data) {
      return data.keys().hasAll(['name', 'relation', 'message', 'status', 'createdAt']) &&
             data.keys().size() <= 7 && // includes optional image and optional userId
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.relation is string && data.relation.size() > 0 && data.relation.size() <= 50 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             ( !('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 3) ); // allow optional images
    }

    match /tributes/{tributeId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow list: if resource.data.status == 'approved' || isAdmin();
      
      // Allow any anonymous user to submit a tribute
      allow create: if isSignedIn() && isValidId(tributeId) && isValidTribute(request.resource.data) && request.resource.data.status == 'pending';
      
      // Only admins can update tributes (to approve/reject)
      allow update, delete: if isAdmin();
    }
    
    match /admins/{userId} {
      allow read: if true;
    }
  }
}
